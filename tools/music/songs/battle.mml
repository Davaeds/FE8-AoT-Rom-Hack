#title  Blade and Wire (battle, player attacks)
#song   0x19
#tempo  176
#reverb 20
; E minor. The main theme (title.mml) at battle speed over driving strings,
; distorted guitar and rock drums. Intro 2 bars, A 8, B 8, breakdown C 8.
; 26 bars, loop from bar 3.

; strings, sixteenths, one bar each
#define SEM o4 l16 [!e e b !e e b !g e]2
#define SC  o4 l16 [!e e >c< !e e >c< !g e]2
#define SG  o4 l16 [!d d b !d d b !g d]2
#define SD  o4 l16 [!d d a !d d a !f+ d]2
#define SAM o4 l16 [!e e a !e e a !c e]2
#define SB  o4 l16 [!d+ d+ b !d+ d+ b !f+ d+]2
; guitar power chords, eighths (root and fifth), one bar each
#define GEM o2 l8 {e b} {e b} {e b} r {e b} {e b} r {e b}
#define GC  o2 l8 {c g} {c g} {c g} r {c g} {c g} r {c g}
#define GG  o2 l8 {< g > d} {< g > d} {< g > d} r {< g > d} {< g > d} r {< g > d}
#define GD  o2 l8 {d a} {d a} {d a} r {d a} {d a} r {d a}
#define GAM o2 l8 {< a > e} {< a > e} {< a > e} r {< a > e} {< a > e} r {< a > e}
#define GB  o2 l8 {< b > f+} {< b > f+} {< b > f+} r {< b > f+} {< b > f+} r {< b > f+}
; guitar breakdown riff (palm-muted chug with chromatic turn)
#define RIFF o2 l8 e e g e a+ e a g
; bass, eighths
#define BEM o2 l8 [e]8
#define BC  o2 l8 [c]8
#define BG  o1 l8 [g]8
#define BD  o2 l8 [d]8
#define BAM o1 l8 [a]8
#define BB  o1 l8 [b]8
; drums
#define ROCK  o2 l8 c f+ d f+ c c d f+
#define ROCKX o2 l8 {c > c+ <} f+ d f+ c c d f+
#define FILL  o2 l16 d d d d f f f f a a a a > c c d d <

A: @61 p76 V112 v100 o3 l8 b b b r b b r16 b16 b8 | l4 b r > e r <
A: L o4 e4 b4 b4. a8 | g4 a4 b2 | > d4 < b4 a4 g4 | f+2 d2
A:   e4 b4 b4. a8 | g4 a4 b4 > c4 | e4 d4 c4 < b4 | b1
A:   g4. a8 b4 > c4 | d4. c8 < b4 a4 | b4 g4 e4 g4 | f+2 d+2
A:   g4. a8 b4 > c4 | d4. e8 f+4 d4 | > c4 < b4 a4 > c4 | < b1
A:   r1 | r1 | r1 | r1 | o4 e2 g2 | g2 b2 | a2 > c2 | < b2 > d+2

B: @48 p48 V96 v88 o4 l16 [e]16 [e]8 [f+]4 [g]4
B: L $SEM $SC $SG $SD $SEM $SC $SAM $SB
B:   $SC $SD $SEM $SB $SC $SD $SAM $SB
B:   $SEM $SEM $SEM $SB $SEM $SEM $SAM $SB

C: @30 p88 V104 v80 o2 l8 {e b} {e b} {e b} r {e b} {e b} r16 {e b}16 {e b} | l4 {e b} r {e b} r
C: L $GEM $GC $GG $GD $GEM $GC $GAM $GB
C:   $GC $GD $GEM $GB $GC $GD $GAM $GB
C:   [$RIFF]3 o2 l8 {< b > f+} r {< b > f+} r {< b > f+} {< b > f+} {< b > f+} {< b > f+}
C:   [$RIFF]2 $GAM $GB

D: @52 p36 V84 v72 r1 r1
D: L o4 {e g b}1 {e g >c<}1 {d g b}1 {d f+ a}1 {e g b}1 {e g >c<}1 {e a >c<}1 {d+ f+ b}1
D:   {e g >c<}1 {d f+ a}1 {e g b}1 {d+ f+ b}1 {e g >c<}1 {d f+ a}1 {e a >c<}1 {d+ f+ b}1
D:   v84 {e g b}1 {e g b}1 {e g b}1 {d+ f+ b}1 {e g b}1 {e g b}1 {e a >c<}1 {d+ f+ b}1 v72

E: @33 p64 V110 v100 o2 l8 e e e r e e r16 e16 e | l4 e r e r
E: L $BEM $BC $BG $BD $BEM $BC $BAM $BB
E:   $BC $BD $BEM $BB $BC $BD $BAM $BB
E:   $BEM $BEM $BEM $BB $BEM $BEM $BAM $BB

F: @127 p64 V100 v96 o2 l8 {c > c+ <} r {c > c+ <} r {c > c+ <} {c > c+ <} r16 d16 d | $FILL
F: L $ROCKX [$ROCK]6 $FILL
F:   $ROCKX [$ROCK]6 $FILL
F:   o2 l8 c r c r d r c c | c r c r d r c c | c r c r d r c c | c r c r d d d d
F:   $ROCKX [$ROCK]2 $FILL

G: @60 p100 V96 v84 r1 r1
G: L r1 r1 r1 r1 r1 r1 r1 r1
G:   o4 e1 | f+1 | g1 | f+2 d+2 | e1 | f+2 a2 | a2 e2 | d+1
G:   r1 | r1 | r1 | r1 | o3 b2 > e2 | e2 g2 | e2 a2 | f+2 < b2
