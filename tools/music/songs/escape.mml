#title  Run (escape through the burning streets)
#song   0x14
#tempo  176
; F minor: i-VI-VII-V twice, staccato strings, brass stabs, running snare.

#define SF  [f a- >c< a-]2
#define SDB [f a- >d-< a-]2
#define SEB [g b- >e-< b-]2
#define SC  [e g >c< g]2
