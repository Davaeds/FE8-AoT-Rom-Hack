AoTCharacter(AoT_Garrison,     AoT_NameGarrison,       AoT_DescGarrison,       AoT_ClsGarrison, AoT_MugSoldier, 3, 22, 6, 6, 6, 4, 1, 2, 10, DRank, 0, 0, 0, 0, 0, 0, 0, 0)
AoTCharacter(AoT_Titan,        AoT_NameTitan,          AoT_DescTitan,          AoT_ClsTitan,    0,             10, 60, 18, 4, 3, 7, 0, 0, 25, NoRank, 0, 0, 0, 0, 0, 0, 0, GiveNoExp)
AoTCharacter(AoT_SmilingTitan, AoT_NameSmilingTitan,   AoT_DescSmilingTitan,   AoT_ClsSmiling,  0,             10, 60, 18, 5, 4, 7, 0, 0, 25, NoRank, 0, 0, 0, 0, 0, 0, 0, GiveNoExp)
AoTCharacter(AoT_Colossal,     AoT_NameColossal,       AoT_DescColossal,       AoT_ClsColossal, 0,             20, 60, 30, 5, 0, 20, 5, 0, 30, NoRank, 0, 0, 0, 0, 0, 0, 0, GiveNoExp)
