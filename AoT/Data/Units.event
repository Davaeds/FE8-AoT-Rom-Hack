AoTCharacter(AoT_Townsperson,  AoT_NameTownsperson,    AoT_DescTownsperson,    0x6D,            0,              1, 10, 1, 1, 3, 0, 0, 3, 6, NoRank, 0, 0, 0, 0, 0, 0, 0, GiveNoExp)

// Hannes keeps the Lethality skill idea for later chapters; here he only carries kids.
PUSH
ORG PersonalSkillTable + AoT_Eren;     BYTE 0
ORG PersonalSkillTable + AoT_Mikasa;   BYTE 0
ORG PersonalSkillTable + AoT_Armin;    BYTE 0
ORG PersonalSkillTable + AoT_Hannes;   BYTE 0
ORG PersonalSkillTable + AoT_Carla;    BYTE 0
ORG PersonalSkillTable + AoT_Garrison; BYTE 0
POP

// ---------------------------------------------------------------- items
//      id               name            desc                type  attributes                                  uses mt hit wt crit range rank   icon wexp
AoTItem(AoT_ItemBladeID, AoT_ItemBlade,  AoT_ItemBladeDesc,  0x0,  IsWeapon,                                    40,  6, 85, 3, 5,  0x11, ERank, 0x4, 1)
AoTItem(AoT_ItemGraspID, AoT_ItemGrasp,  AoT_ItemGraspDesc,  0xB,  IsWeapon|Indestructible|MonsterWeapon,       0,  14, 70, 10, 0, 0x11, NoRank, 0xD2, 0)
