// Portraits. Each PNG is a 128x112, 16-colour "hackbox" sheet (main portrait,
// mouth frames, eye frames, minimug), converted by PortraitFormatter at build time.
// setMugEntry(mug, data, mouthX, mouthY, eyeX, eyeY): positions are in tiles.

ALIGN 4
AoT_MugEren_Data:
#incext PortraitFormatter "Portraits/Eren.png"
setMugEntry(AoT_MugEren, AoT_MugEren_Data, 4, 6, 4, 4)

ALIGN 4
AoT_MugMikasa_Data:
#incext PortraitFormatter "Portraits/Mikasa.png"
