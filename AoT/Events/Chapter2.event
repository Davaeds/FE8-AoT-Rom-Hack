// Debug: a dummy next to Eren, to test fights.
#ifdef AoT_DEBUG_BATTLE
AoT_C2DebugDummy:
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [7,9] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT
#endif

AoT_C2ShadisUnit:
UNIT AoT_Shadis AoT_ClsCadet 0 Level(10,NPC,0) [8,9] 0 [0,0,0,0] [0x06,0x03,0,0]
UNIT

// ---------------------------------------------------------------- opening
AoT_C2BeginningScene:
// Armin: the years after Wall Maria fell.
CGTEXTSTART
BACG 0
MUSC AoT_SongNarration
FADU 16
TEXTSHOW AoT_C2Narration
TEXTEND
FADI 16
REMA
TEXTSTART
CLEAN

// The squad that came through Shiganshina is gone; three years later they
// are cadets with new stats and gear.
ASMC AoT_ASMC_ClearPlayers|1
LOAD1 0 AoT_C2Squad
LOAD1 0 AoT_C2Dummies
LOAD1 0 AoT_C2Rivals
LOAD1 0 AoT_C2ShadisUnit
#ifdef AoT_DEBUG_BATTLE
LOAD1 0 AoT_C2DebugDummy
#endif
ENUN
CAMERA [4,6]
MUSC AoT_SongPeace
FADU 16
BROWNBOX AoT_C2CaptionYear [8,8]
BROWNBOX AoT_C2CaptionPlace [8,8]
AoT_Talk(AoT_C2Briefing)
AoT_Talk(AoT_C2Banter)
REMOVEUNIT AoT_Shadis

CAMERA_CENTERED [11,5]
CURSOR_FLASHING [9,5]
AoT_Tutorial(AoT_C2HowTo)
REMOVE_CURSORS
CAMERA [4,6]
MUSC AoT_SongRaid
NoFade
ENDA

AoT_C2RivalsTalk:
CAMERA [20,14]
STAL 20
CAMERA [4,6]
AoT_Talk(AoT_C2RivalsLine)
NoFade
ENDA

// ---------------------------------------------------------------- ending
AoT_C2EndingScene:
MUSC AoT_SongPeace
AoT_Talk(AoT_C2ExamOver)

// Graduation and the top ten, then Trost.
MUSC AoT_SongNarration
FADI 16
REMA
CGTEXTSTART
BACG 0
FADU 16
TEXTSHOW AoT_C2Graduation
TEXTEND
TEXTSHOW AoT_ToBeContinued
TEXTEND
FADI 8
MNTS 0
ENDA
