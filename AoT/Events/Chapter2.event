// Chapter 2 (FE8 chapter slot 1): The 104th Cadet Corps.
//
// Opening: Armin narrates the years after Shiganshina; Instructor Shadis opens
// the final field exam in the forest.
// Play: cut down every wooden Titan dummy. Cadets fly over trees and cliffs on
// ODM gear (flier move costs); a rival cadet squad competes for the dummies.
// Ending: graduation, the top ten, and the Colossal Titan's return at Trost.
//
// Map: vanilla map 92 (forest with cliffs, 30x21) with its own tileset and
// palette, so nothing new is stored for it.

// ---------------------------------------------------------------- chapter data
PUSH
ORG ChapterDataTable + 148 + 4
BYTE 1 0 91 3 92 5 0 93         // objects, palette, tileset, map, anims, map changes (as vanilla chapter data entry 20)
ORG ChapterDataTable + 148 + 0x16
SHORT AoT_SongRaid AoT_SongRaid AoT_SongRaid AoT_SongRaid AoT_SongRaid AoT_SongRaid AoT_SongRaid
ORG ChapterDataTable + 148 + 0x70
SHORT AoT_C2Title AoT_C2Title
ORG ChapterDataTable + 148 + 0x86
BYTE 0 1
SHORT AoT_C2ObjectiveStatus AoT_C2ObjectiveGoal
BYTE 4 0 0
POP

EventPointerTable(10, AoT_C2Events)

// No world map narration before this chapter either (Events_WM_Beginning[2]).
PUSH
ORG 0x8B39F4
POIN AoT_WMSkip
POP

ALIGN 4
AoT_C2Events:
POIN AoT_C2Turns
POIN AoT_C2Characters
POIN AoT_C2Locations
POIN AoT_C2Misc
POIN AoT_C2Empty AoT_C2Empty AoT_C2Empty AoT_C2Empty
POIN AoT_C2Traps AoT_C2Traps
POIN AoT_C2Squad AoT_C2Squad
POIN 0 0 0
POIN 0 0 0
POIN AoT_C2BeginningScene AoT_C2EndingScene

// ---------------------------------------------------------------- event lists
AoT_C2Turns:
TurnEventPlayer(AoT_FlagRivals, AoT_C2RivalsTalk, 3)
// Debug: with AoT_DEBUG_PLAYTHROUGH the ending plays as soon as turn 1 starts.
#ifdef AoT_DEBUG_PLAYTHROUGH
TurnEventPlayer(0, AoT_C2EndingScene, 1)
#endif
END_MAIN

AoT_C2Characters:
END_MAIN

AoT_C2Locations:
END_MAIN

AoT_C2Misc:
CauseGameOverIfLordDies
DefeatAll(AoT_C2EndingScene)
END_MAIN

AoT_C2Empty:
END_MAIN

AoT_C2Traps:
ENDTRAP
ALIGN 4

// ---------------------------------------------------------------- units
// Three years of training: the squad auto-levels from the character bases.
AoT_C2Squad:
UNIT AoT_CadetEren   AoT_ClsCadetEren   0 Level(5,Ally,1) [6,9] 0 [AoT_ItemTrainingID,0,0,0] [0,0,0,0]
UNIT AoT_CadetMikasa AoT_ClsCadetMikasa 0 Level(6,Ally,1) [7,8] 0 [AoT_ItemTrainingID,0,0,0] [0,0,0,0]
UNIT AoT_CadetArmin  AoT_ClsCadetArmin  0 Level(4,Ally,1) [5,9] 0 [AoT_ItemTrainingID,0,0,0] [0,0,0,0]
UNIT AoT_Jean   AoT_ClsCadetJean   0 Level(5,Ally,1) [6,8] 0 [AoT_ItemTrainingID,0,0,0] [0,0,0,0]
UNIT

