UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [19,6]  0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [22,8]  0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [24,10] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [28,11] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [19,13] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [10,13] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
UNIT AoT_Dummy AoT_ClsDummy 0 Level(1,Enemy,0) [27,15] 0 [AoT_ItemDummyArmID,0,0,0] [0,0,0,0]
